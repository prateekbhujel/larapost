{
    "name": "socialsync/laravel-social-sync",
    "description": "Unified social media posting SDK for Laravel - Post to multiple platforms with a single API",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "social-media",
        "facebook",
        "instagram",
        "twitter",
        "linkedin",
        "scheduling",
        "crm"
    ],
    "authors": [
        {
            "name": "Pratik Bhujel",
            "email": "prateekbhujelpb@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "guzzlehttp/guzzle": "^7.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "SocialSync\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialSync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialSync\\SocialSyncServiceProvider"
            ],
            "aliases": {
                "SocialMedia": "SocialSync\\Facades\\SocialMedia"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
