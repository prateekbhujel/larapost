{
    "name": "prateekbhujel/larapost",
    "description": "Production-grade social publishing and scheduling tools for Laravel",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/prateekbhujel/larapost",
    "readme": "README.md",
    "keywords": [
        "laravel",
        "social-media",
        "facebook",
        "instagram",
        "twitter",
        "linkedin",
        "scheduling"
    ],
    "authors": [
        {
            "name": "Pratik Bhujel",
            "email": "prateekbhujelpb@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/prateekbhujel/larapost/issues",
        "source": "https://github.com/prateekbhujel/larapost",
        "docs": "https://prateekbhujel.github.io/larapost/"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SocialSync\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SocialSync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialSync\\SocialSyncServiceProvider"
            ],
            "aliases": {
                "SocialMedia": "SocialSync\\Facades\\SocialMedia"
            }
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "qa": [
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
