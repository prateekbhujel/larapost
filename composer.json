{
    "name": "prateekbhujel/larapost",
    "description": "Laravel-native social publishing infrastructure for Facebook, X, LinkedIn, TikTok, queues, scheduling, and optional MCP clients",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/prateekbhujel/larapost",
    "readme": "README.md",
    "keywords": [
        "laravel",
        "social-media",
        "social-publishing",
        "facebook",
        "twitter",
        "x",
        "linkedin",
        "tiktok",
        "scheduling",
        "queue",
        "mcp",
        "model-context-protocol",
        "chatgpt",
        "claude"
    ],
    "authors": [
        {
            "name": "Pratik Bhujel",
            "email": "prateekbhujelpb@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/prateekbhujel/larapost/issues",
        "source": "https://github.com/prateekbhujel/larapost",
        "docs": "https://prateekbhujel.github.io/larapost/"
    },
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/bus": "^12.41.1|^13.0",
        "illuminate/console": "^12.41.1|^13.0",
        "illuminate/contracts": "^12.41.1|^13.0",
        "illuminate/database": "^12.41.1|^13.0",
        "illuminate/http": "^12.41.1|^13.0",
        "illuminate/queue": "^12.41.1|^13.0",
        "illuminate/routing": "^12.41.1|^13.0",
        "illuminate/support": "^12.41.1|^13.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "suggest": {
        "laravel/mcp": "Required only when you enable LaraPost's MCP server for ChatGPT, Claude, Codex, or another MCP client."
    },
    "require-dev": {
        "laravel/mcp": "^1.0",
        "orchestra/testbench": "^10.8|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SocialSync\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SocialSync\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocialSync\\SocialSyncServiceProvider"
            ],
            "aliases": {
                "SocialMedia": "SocialSync\\Facades\\SocialMedia"
            }
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "qa": [
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
